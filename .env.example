# Supabase API Credentials
# These are exposed to the client-side app via Vite
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Truecaller Configuration
VITE_TRUECALLER_PARTNER_KEY=your-truecaller-partner-key

# Firebase Admin Configuration for Production/Vercel (Real Firestore connections)
# Option 1: Provide the entire downloaded service account JSON string as a single variable (Highly Recommended)
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "zenoa-inolas", ...}'

# Option 2: Individual variables
FIREBASE_PROJECT_ID=zenoa-inolas
FIREBASE_CLIENT_EMAIL=your-firebase-adminsdk-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
