{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "display_name": { "type": "string" },
        "bio": { "type": "string" },
        "avatar_seed": { "type": "string" },
        "avatar_url": { "type": "string" },
        "online": { "type": "boolean" },
        "last_seen": { "type": "string" },
        "last_seen_timestamp": { "type": "number" },
        "custom_status": { "type": "string" },
        "activity_status": { "type": "string" },
        "activity_type": { "type": "string" },
        "followers": { "type": "array" },
        "following": { "type": "array" },
        "is_private": { "type": "boolean", "description": "Whether the account is private" }
      }
    },
    "FollowRequest": {
      "title": "Follow Request",
      "description": "Pending follow requests for private accounts",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "toId": { "type": "string" },
        "fromName": { "type": "string" },
        "fromUsername": { "type": "string" },
        "fromAvatar": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "timestamp": { "type": "number" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications for social activities",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["follow_request", "follow_accept", "new_follower", "mention"] },
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "fromUsername": { "type": "string" },
        "fromAvatar": { "type": "string" },
        "read": { "type": "boolean" },
        "timestamp": { "type": "number" }
      }
    },
    "Chat": {
      "title": "Chat",
      "description": "Direct and group conversation sessions",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "last_message": { "type": "string" },
        "updated_at": { "type": "number" },
        "created_at": { "type": "number" },
        "is_group": { "type": "boolean" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "Encrypted chat message payload",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "encrypted": { "type": "boolean" },
        "type": { "type": "string" }
      }
    },
    "Call": {
      "title": "Call",
      "description": "WebRTC audio/video signaling session",
      "type": "object",
      "properties": {
        "callerId": { "type": "string" },
        "recipientId": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "DeviceLinkSession": {
      "title": "Device Link Session",
      "description": "Ephemeral companion pairing session for Zenoa Web",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      }
    },
    "SSOApplication": {
      "title": "SSO Application",
      "description": "Registered OAuth 2.0 application profile",
      "type": "object",
      "properties": {
        "client_id": { "type": "string" },
        "app_name": { "type": "string" },
        "owner": { "type": "string" },
        "created_at": { "type": "number" }
      }
    },
    "LinkedGoogleVault": {
      "title": "Linked Google Vault",
      "description": "Enforces 1:1 mapping between a Google Drive account hash and a Zenoa user",
      "type": "object",
      "properties": {
        "owner_username": { "type": "string" },
        "owner_user_id": { "type": "string" },
        "linked_at": { "type": "number" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "follow_requests/{requestId}": {
      "schema": "FollowRequest",
      "description": "Collection for managing follow requests"
    },
    "notifications/{notifId}": {
      "schema": "Notification",
      "description": "Collection for user notifications"
    },
    "chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat conversations"
    },
    "messages/{messageId}": {
      "schema": "Message",
      "description": "Encrypted chat messages"
    },
    "calls/{callId}": {
      "schema": "Call",
      "description": "WebRTC call signaling"
    },
    "device_link_sessions/{sessionId}": {
      "schema": "DeviceLinkSession",
      "description": "Companion device linking sessions"
    },
    "sso_applications/{appId}": {
      "schema": "SSOApplication",
      "description": "SSO and OAuth client applications"
    },
    "linked_google_vaults/{vaultHash}": {
      "schema": "LinkedGoogleVault",
      "description": "Unique Google Drive account linking index"
    }
  }
}
