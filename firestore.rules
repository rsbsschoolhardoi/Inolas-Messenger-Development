rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net catch-all: default-deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Users collection: allow public read of profiles for discovery/search; signed in users can update
    match /users/{userId} {
      allow read: if true; 
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == 'azadaman19s@gmail.com');
      
      // Privacy Gate: allow owner or admin to read/write sub-data
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
        allow delete: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == 'azadaman19s@gmail.com');
      }
    }

    // Reports collection for user reports and moderation
    match /reports/{reportId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Audit logs collection for administrative history
    match /audit_logs/{logId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Broadcasts collection for official service announcements
    match /broadcasts/{broadcastId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Service accounts registry
    match /service_accounts/{accountId} {
      allow read, create, update, delete: if isSignedIn();
    }
    // Developer Apps collection for bots & API keys
    match /developer_apps/{appId} {
      allow read: if true; 
      allow create, update, delete: if isSignedIn();
    }

    match /otps/{otpId} {
      allow read, write: if true;
    }

    match /developer_analytics/{appId} {
      allow read, write: if true;
    }

    match /developer_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isSignedIn();
    }

    // Notifications collection: users only see their own notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Follow requests collection: sender and recipient can see them
    match /follow_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid);
    }

    // Username reservation lookup
    match /usernames/{cleanUsername} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Chats collection
    match /chats/{chatId} {
      allow read, create, update, delete: if isSignedIn();
      match /{allPaths=**} {
        allow read, create, update, delete: if isSignedIn();
      }
    }

    // Messages collection
    match /messages/{messageId} {
      allow read, create, update, delete: if isSignedIn();
      match /{allPaths=**} {
        allow read, create, update, delete: if isSignedIn();
      }
    }

    // Calls collection with candidates subcollection
    match /calls/{callId} {
      allow read, create, update, delete: if isSignedIn();
      match /{allPaths=**} {
        allow read, create, update, delete: if isSignedIn();
      }
    }
  }
}
