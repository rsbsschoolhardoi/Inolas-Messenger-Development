rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || (resource != null && resource.data.uid == request.auth.uid));
    }

    // 1. Users collection: Public profile discovery, owner-restricted writes
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || (resource != null && resource.data.uid == request.auth.uid));

      match /{subCollection=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // 2. Chats: Only participants can read or modify conversations
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.participants == null || 
        resource.data.participants.hasAny([request.auth.uid])
      );
      allow create: if isAuthenticated() && (
        request.resource.data.participants == null || 
        request.resource.data.participants.hasAny([request.auth.uid])
      );
      allow update: if isAuthenticated() && (
        resource.data.participants == null || 
        resource.data.participants.hasAny([request.auth.uid])
      );
      allow delete: if isAuthenticated() && (
        resource.data.participants == null || 
        resource.data.participants.hasAny([request.auth.uid])
      );

      match /{allPaths=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 3. Messages: Chat participants only
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid
      );

      match /{allPaths=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 4. Calls: WebRTC video & audio signaling
    match /calls/{callId} {
      allow read, write, create, update, delete: if isAuthenticated();
      
      match /{allPaths=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 5. Notifications: Only target user can read and modify
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
    }

    // 6. Follow requests
    match /follow_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Username reservation lookup
    match /usernames/{cleanUsername} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 8. Device link sessions (Zenoa Web companion pairing handshake)
    match /device_link_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 9. SSO Applications: Public config for consent screen, authenticated management
    match /sso_applications/{appId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /sso_clients/{appId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 10. OAuth 2.0 Auth Codes & Tokens
    match /oauth_codes/{codeId} {
      allow read, write: if true;
    }
    match /oauth_tokens/{tokenId} {
      allow read, write: if true;
    }
    match /sso_auth_codes/{codeId} {
      allow read, write: if true;
    }
    match /sso_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 11. Reports & Audit logs
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // 12. Service accounts
    match /service_accounts/{accountId} {
      allow read, write: if false;
    }

    // 13. Linked Google Vaults (1:1 account security mapping)
    match /linked_google_vaults/{vaultHash} {
      allow read, write: if true;
    }

    // Default catch-all: Deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
