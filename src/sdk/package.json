{
  "name": "@zenoa/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript & JavaScript SDK for Zenoa Developer Platform, OAuth 2.0 Identity & Service Account Messaging.",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "bin": {
    "zenoa": "./bin/zenoa.js"
  },
  "scripts": {
    "build": "npx --yes tsup index.ts auth.ts bot.ts otp.ts webhook.ts cli.ts --format cjs,esm --dts",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "zenoa",
    "oauth2",
    "openid-connect",
    "sso",
    "bot",
    "messenger",
    "otp",
    "authentication",
    "identity"
  ],
  "author": "Zenoa Inolas Team",
  "license": "MIT",
  "homepage": "https://zenoa-inolas.vercel.app/developer",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenoa/zenoa-sdk.git"
  }
}
